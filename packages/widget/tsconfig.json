{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": ["src"],
  // Ce paquet compile pour le NAVIGATEUR : ses types ne connaissent ni
  // node:fs ni process. Le banc __probe-tube.ts lit des polices sur le
  // disque et tourne sous vite-node ; il est donc hors du typage du
  // bundle, comme le sont ses imports Node.
  "exclude": ["src/__probe-tube.ts"]
}
